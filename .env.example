# ── Dify 服务配置 ────────────────────────────────────────────────────────────
# Dify 内网地址（不含 /v1）
DIFY_BASE_URL=http://192.168.1.100

# ── 各 Dify App 的 API Key 在 dify_apps.json 中单独配置 ──────────────────────

# ── 端口配置 ──────────────────────────────────────────────────────────────────
# 自定义门户访问端口（主入口，默认 80）
PORTAL_PORT=80

# Open WebUI 访问端口（可选，高级功能用，默认 3000）
OPEN_WEBUI_PORT=3000

# ── 安全配置 ──────────────────────────────────────────────────────────────────
# Pipelines 内部认证密钥（保持默认即可，不对外暴露）
PIPELINES_API_KEY=0p3n-w3bu!

# Open WebUI 安全密钥（请修改）
WEBUI_SECRET_KEY=changeme-please-use-a-random-string

# Open WebUI 界面名称
WEBUI_NAME=AI 助手平台
