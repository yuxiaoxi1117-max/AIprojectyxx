# Dify service address (internal network, e.g. http://192.168.1.100 or http://dify.local)
DIFY_API_BASE_URL=http://YOUR_DIFY_INTERNAL_IP

# Dify App API Key — found in Dify dashboard > App > API Access
DIFY_API_KEY=app-xxxxxxxxxxxxxxxxxxxxxxxxxxxxxxxx

# Display name shown in Open WebUI
WEBUI_NAME=Open WebUI + Dify
