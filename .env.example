# ── Dify 服务配置 ────────────────────────────────────────────────
# Dify 内网地址（不要加 /v1，只填到 IP 或域名）
DIFY_BASE_URL=http://192.168.1.100

# Dify App API Key（Dify 控制台 → 应用 → API 访问 → API 密钥）
DIFY_API_KEY=app-xxxxxxxxxxxxxxxxxxxxxxxxxxxxxxxx

# 在 Open WebUI 中显示的模型名称
DIFY_APP_NAME=我的 Dify 助手

# ── Open WebUI 配置 ───────────────────────────────────────────────
# Open WebUI 访问端口（默认 3000）
OPEN_WEBUI_PORT=3000

# Open WebUI 界面标题
WEBUI_NAME=Open WebUI + Dify

# 安全密钥（请修改为随机字符串）
WEBUI_SECRET_KEY=changeme-please-use-a-random-string

# ── Pipelines 内部密钥 ────────────────────────────────────────────
# Open WebUI 与 Pipelines 服务之间的认证密钥（可保持默认）
PIPELINES_API_KEY=0p3n-w3bu!
